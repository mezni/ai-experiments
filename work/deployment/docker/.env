# === Common Variables ===
RUST_LOG=info
LOG_LEVEL=info

# === Auth Service ===
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=5100
AUTH_JWT_SECRET=your-auth-jwt-secret-change-this
AUTH_JWT_EXPIRY_HOURS=24

# === PostGIS Database ===
POSTGRES_PORT=5432
POSTGRES_DB=ev_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgres://postgres:password@localhost:5432/ev_db

# OSM Data Configuration
REGION=tunisia
DATADIR=/osm/data

# === Locator Service ===
LOCATOR_SERVICE_HOST=0.0.0.0
LOCATOR_SERVER_PORT=5800

# === Configurator Service ===
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=5900
