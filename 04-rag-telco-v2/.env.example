# Telecom Policy Assistant — environment template
# Copy to `.env` and fill values locally. NEVER commit real secrets.

# --- PostgreSQL (also used by docker compose) ---
POSTGRES_USER=policy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=policy_assistant
# Backend connection string (local run) / overridden by compose when using containers
DATABASE_URL=postgresql+psycopg2://policy:change-me@localhost:5432/policy_assistant

# --- External AI provider (reported separately in readiness) ---
OPENROUTER_API_KEY=

# --- Session / application secrets ---
JWT_SECRET=

# --- Langfuse (observability / tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=admin

# --- Grafana (monitoring dashboard) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin