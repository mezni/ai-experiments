# Copied from .env.example — fill in real values.

# Anthropic SDK wrapper (src/llm/llm_client.py) resolves the key in this
# order: ANTHROPIC_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY.
ANTHROPIC_API_KEY=

# Route Anthropic requests through a compatible provider (e.g. OpenRouter).
# Leave unset to hit the Anthropic API directly.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: used by sentence-transformers and Hugging Face model downloads.
HF_TOKEN=