# === Common Variables ===
RUST_LOG=info
LOG_LEVEL=info

# === Auth Service ===
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=5100
AUTH_JWT_SECRET=your-auth-jwt-secret-change-this
AUTH_JWT_EXPIRY_HOURS=24

# === Database Service ===
DB_SERVICE_HOST=0.0.0.0
DB_SERVICE_PORT=5101
DB_CONNECTION_STRING=postgresql://user:pass@postgres:5432/db

# === API Service ===
API_SERVICE_HOST=0.0.0.0
API_SERVICE_PORT=5102
API_RATE_LIMIT=100

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === PostgreSQL ===
POSTGRES_PORT=5432
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpass