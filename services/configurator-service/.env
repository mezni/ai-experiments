# -------------------------
# Server configuration
# -------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug

# -------------------------
# Database configuration
# Use either DATABASE_URL or individual DB params
# -------------------------
# Full Postgres URL (overrides individual params if present)
# DATABASE_URL=postgres://postgres:password@localhost:5432/ev_db

# Individual DB config (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ev_db

# -------------------------
# CORS configuration
# Comma-separated allowed origins. Use * for all
# -------------------------
CORS_ALLOWED_ORIGINS=*

# -------------------------
# Optional features
# -------------------------
# LOG_FORMAT=json
# MAX_DB_CONNECTIONS=10
